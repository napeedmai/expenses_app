.env*.local

# Firebase / FCM service account key — grants the ability to send push
# notifications as this project. Must never be committed.
# NOTE: google-services.json is NOT secret (it holds public identifiers) and
# SHOULD be committed, or Android builds cannot register with FCM.
*service-account*.json
*serviceaccount*.json
*-firebase-adminsdk-*.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

